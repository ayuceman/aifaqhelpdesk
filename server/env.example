PORT=3001

# Support & Contact
SUPPORT_EMAIL=support@yourcompany.com
CLIENT_URL=http://localhost:5173

# =============================================================================
# AI PROVIDER CONFIGURATION
# Choose your AI provider: ollama, openai, huggingface, or gemini
# Default: ollama (runs locally, free)
# =============================================================================
AI_PROVIDER=ollama

# Use Ollama by default (legacy flag, kept for backward compatibility)
USE_OLLAMA=true

# -----------------------------------------------------------------------------
# OLLAMA CONFIGURATION (Local LLM - Default, Free)
# Install: https://ollama.ai
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# OPENAI CONFIGURATION (Best Quality, Pay-per-use)
# Get API key: https://platform.openai.com/api-keys
# Pricing: ~$0.50/1M tokens (very affordable)
# $5 free credit for new accounts
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Legacy variables (still supported)
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# GOOGLE GEMINI CONFIGURATION (Good Quality, Free Tier Available)
# Get API key: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/min
# Pricing: ~$0.075/1M tokens
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# HUGGING FACE CONFIGURATION (Free Tier Available)
# Get API key: https://huggingface.co/settings/tokens
# Free tier available with rate limits
# -----------------------------------------------------------------------------
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=microsoft/phi-2
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Security
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=60